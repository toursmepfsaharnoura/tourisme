<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{#if user}}
  <meta name="user-id" content="{{user.id}}">
  {{/if}}
  <title>{{title}} | Tunisie Authentique</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;700&family=Space+Grotesk:wght@300;400;500;700&display=swap" rel="stylesheet">
  
  <!-- Modern Nature-Inspired Theme -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'ocean-blue': '#0077FF',
            'ocean-light': '#00A8FF',
            'ocean-dark': '#0056CC',
            'sand-dune': '#FFE5B4',
            'sand-warm': '#FFD700',
            'mountain-gray': '#8B9DC3',
            'mountain-dark': '#4A5568',
            'desert-orange': '#FF6B35',
            'desert-pink': '#FF1493',
            'city-teal': '#00CED1',
            'city-navy': '#2C3E50',
            'sage-green': '#32CD32',
            'lavender': '#E6E6FA',
            'coral': '#FF7F50',
            'mist': '#F0F4F8',
            'neon-purple': '#9D4EDD',
            'neon-cyan': '#00FFFF',
            'vibrant-pink': '#FF69B4'
          },
          fontFamily: {
            'inter': ['Inter', 'sans-serif'],
            'playfair': ['Playfair Display', 'serif'],
            'space': ['Space Grotesk', 'sans-serif']
          },
          spacing: {
            '18': '4.5rem',
            '88': '22rem',
            '128': '32rem',
            '112': '28rem'
          },
          animation: {
            'float': 'float 6s ease-in-out infinite',
            'wave': 'wave 10s linear infinite',
            'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'slide-up': 'slideUp 0.8s ease-out',
            'fade-in': 'fadeIn 1.2s ease-out',
            'scale-in': 'scaleIn 0.6s ease-out'
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-20px)' }
            },
            wave: {
              '0%': { transform: 'translateX(0)' },
              '100%': { transform: 'translateX(-100%)' }
            },
            slideUp: {
              '0%': { transform: 'translateY(50px)', opacity: '0' },
              '100%': { transform: 'translateY(0)', opacity: '1' }
            },
            slideDown: {
              '0%': { transform: 'translateY(-100%)', opacity: '0' },
              '100%': { transform: 'translateY(0)', opacity: '1' }
            },
            fadeIn: {
              '0%': { opacity: '0' },
              '100%': { opacity: '1' }
            },
            scaleIn: {
              '0%': { transform: 'scale(0.9)', opacity: '0' },
              '100%': { transform: 'scale(1)', opacity: '1' }
            }
          }
        }
      }
    }
  </script>
  
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    
    .glass-morphism { 
      background: rgba(255, 255, 255, 0.08); 
      backdrop-filter: blur(20px); 
      border: 1px solid rgba(255, 255, 255, 0.15);
      box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.2);
    }
    
    .glass-dark { 
      background: rgba(30, 58, 95, 0.7); 
      backdrop-filter: blur(25px); 
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.3);
    }
    
    .nature-gradient {
      background: linear-gradient(135deg, #0066CC 0%, #4A90E2 25%, #87A96B 50%, #FF6B35 75%, #1E3A5F 100%);
    }
    
    .ocean-gradient {
      background: linear-gradient(135deg, #0066CC 0%, #4A90E2 50%, #008B8B 100%);
    }
    
    .desert-gradient {
      background: linear-gradient(135deg, #FF6B35 0%, #F4E4C1 50%, #FF8FA3 100%);
    }
    
    .mountain-gradient {
      background: linear-gradient(135deg, #6B7280 0%, #374151 50%, #1E3A5F 100%);
    }
    
    .sage-gradient {
      background: linear-gradient(135deg, #32CD32 0%, #228B22 50%, #006400 100%);
    }
    
    .nature-pattern {
      background-image: 
        radial-gradient(circle at 20% 80%, rgba(255, 107, 53, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(0, 102, 204, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 40% 40%, rgba(135, 169, 107, 0.05) 0%, transparent 50%);
    }
    
    .card-hover { 
      transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1); 
    }
    
    .card-hover:hover { 
      transform: translateY(-12px) scale(1.03); 
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4), 0 0 40px rgba(0, 102, 204, 0.1);
    }
    
    .text-shadow-glow {
      text-shadow: 0 0 20px rgba(255, 255, 255, 0.3), 2px 2px 4px rgba(0, 0, 0, 0.3);
    }
    
    .button-glow {
      box-shadow: 0 4px 15px rgba(0, 102, 204, 0.3);
      transition: all 0.3s ease;
    }
    
    .button-glow:hover {
      box-shadow: 0 6px 25px rgba(0, 102, 204, 0.5);
      transform: translateY(-2px);
    }
    
    .floating-element {
      animation: float 6s ease-in-out infinite;
    }
    
    .wave-animation {
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
      animation: wave 10s linear infinite;
    }
    
    /* Notification dropdown animations */
    #notification-dropdown {
      animation: fadeIn 0.2s ease-in-out;
    }
    
    @keyframes fadeIn {
      from { 
        opacity: 0; 
        transform: translateY(-10px); 
      }
      to { 
        opacity: 1; 
        transform: translateY(0); 
      }
    }
    
    .notification-item {
      animation: slideIn 0.3s ease-out;
    }
    
    @keyframes slideIn {
      from { 
        opacity: 0; 
        transform: translateX(-20px); 
      }
      to { 
        opacity: 1; 
        transform: translateX(0); 
      }
    }
    
    /* Bell animation */
    @keyframes bellRing {
      0%, 100% { transform: rotate(0deg); }
      10%, 30% { transform: rotate(-10deg); }
      20%, 40% { transform: rotate(10deg); }
      50% { transform: rotate(0deg); }
    }
    
    .bell-ring {
      animation: bellRing 0.5s ease-in-out;
    }
    
    /* 🔥 PRO NOTIFICATION ANIMATIONS */
    #notifDropdown {
      animation: fadeIn 0.2s ease-in-out;
    }
    
    @keyframes fadeIn {
      from { 
        opacity: 0; 
        transform: translateY(-10px); 
      }
      to { 
        opacity: 1; 
        transform: translateY(0); 
      }
    }
    
    /* Badge pulse animation */
    @keyframes pulse {
      0%, 100% { 
        transform: scale(1); 
      }
      50% { 
        transform: scale(1.1); 
      }
    }
    
    #notifBadge {
      animation: pulse 2s infinite;
    }
    
    /* Hover effects */
    #notifDropdown div[class*="hover:bg-gray-50"] {
      transition: all 0.2s ease;
    }
    
    #notifDropdown div[class*="hover:bg-gray-50"]:hover {
      transform: translateX(2px);
    }
  </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-white to-green-50 min-h-screen text-gray-900 overflow-x-hidden">

  <!-- Navigation -->
  {{#unless hideNavbar}}
    {{> navbar}}
  {{/unless}}

  <!-- MAIN CONTENT -->
  <main class="min-h-screen animate-fade-in">
    {{{body}}}
  </main>

  <!-- Footer -->
  {{#unless hideFooter}}
    {{> footer}}
  {{/unless}}

  <!-- 🔥 PRO NOTIFICATION SYSTEM - FACEBOOK STYLE -->
  {{#if user}}
  <script src="/socket.io/socket.io.js"></script>
  
  <script>
    // 🔥 PRO NOTIFICATION SYSTEM
    const socket = io();
    let notifications = [];
    let userId = {{user.id}};

    // 🔔 toggle dropdown
    function toggleNotif(){
      const dropdown = document.getElementById("notifDropdown");
      dropdown.classList.toggle("hidden");
      
      // Load notifications when opening
      if (!dropdown.classList.contains("hidden")) {
        loadNotif();
      }
    }

    // 🔄 load notifications
    async function loadNotif(){
      try {
        console.log('🔥 Loading notifications for user:', userId);
        const res = await fetch(`/notifications/all?userId=${userId}`);
        notifications = await res.json();
        console.log('✅ Loaded', notifications.length, 'notifications');
        renderNotif();
      } catch (error) {
        console.error('❌ Error loading notifications:', error);
      }
    }

    // 🔴 load badge
    async function loadBadge(){
      try {
        console.log('🔥 Loading badge for user:', userId);
        const res = await fetch(`/notifications/unread-count?userId=${userId}`);
        const data = await res.json();
        
        const badge = document.getElementById("notifBadge");
        const badgeMobile = document.getElementById("notifBadgeMobile");
        const badgeMobileIcon = document.getElementById("notifBadgeMobileIcon");
        
        console.log('📊 Badge data:', data);
        console.log('🔍 Found badges:', { badge: !!badge, badgeMobile: !!badgeMobile, badgeMobileIcon: !!badgeMobileIcon });
        
        if (data.count > 0) {
          const countText = data.count > 99 ? '99+' : data.count;
          
          // Update bell badge (desktop)
          if (badge) {
            badge.textContent = countText;
            badge.style.display = 'flex';
            console.log('✅ Bell badge updated:', countText);
          }
          
          // Update mobile badge (dropdown menu)
          if (badgeMobile) {
            badgeMobile.textContent = countText;
            badgeMobile.style.display = 'inline-block';
            console.log('✅ Mobile badge updated:', countText);
          }
          
          // Update mobile icon badge (mobile navbar)
          if (badgeMobileIcon) {
            badgeMobileIcon.textContent = countText;
            badgeMobileIcon.style.display = 'flex';
            console.log('✅ Mobile icon badge updated:', countText);
          }
        } else {
          // Hide all badges
          if (badge) {
            badge.style.display = 'none';
            console.log('🙈 Bell badge hidden');
          }
          if (badgeMobile) {
            badgeMobile.style.display = 'none';
            console.log('🙈 Mobile badge hidden');
          }
          if (badgeMobileIcon) {
            badgeMobileIcon.style.display = 'none';
            console.log('🙈 Mobile icon badge hidden');
          }
        }
        
        console.log('🔢 Final unread count:', data.count);
      } catch (error) {
        console.error('❌ Error loading badge:', error);
      }
    }

    // 📦 render list
    function renderNotif(){
      const list = document.getElementById("notifList");
      
      if (notifications.length === 0) {
        list.innerHTML = `
          <div class="text-center py-8 text-gray-500">
            <i class="fas fa-bell-slash text-3xl mb-2"></i>
            <p class="text-sm">Aucune notification</p>
          </div>
        `;
        return;
      }

      list.innerHTML = notifications.map(n => `
        <div class="p-3 border-b border-gray-100 hover:bg-gray-50 cursor-pointer flex justify-between transition-colors ${n.est_vu == 0 ? 'bg-blue-50' : ''}"
             onclick="markRead(${n.id})">

          <div class="flex-1">
            <div class="flex items-center mb-1">
              <span class="inline-block px-2 py-1 text-xs rounded-full font-medium ${getTypeColor(n.type)}">
                ${getTypeIcon(n.type)} ${getTypeLabel(n.type)}
              </span>
              ${n.est_vu == 0 ? '<span class="w-2 h-2 bg-blue-500 rounded-full ml-2"></span>' : ''}
            </div>
            <p class="text-sm font-semibold text-gray-900">${n.contenu.substring(0, 60)}...</p>
            <p class="text-xs text-gray-500 mt-1">${formatDate(n.date_creation)}</p>
          </div>

        </div>
      `).join('');
    }

    // ✔️ mark as read
    async function markRead(id){
      try {
        console.log('📖 Marking notification as read:', id);
        await fetch('/notifications/read/' + id, { method:'PUT' });

        // Update local data
        notifications = notifications.map(n =>
          n.id === id ? {...n, est_vu: 1} : n
        );

        renderNotif();
        loadBadge();
      } catch (error) {
        console.error('❌ Error marking as read:', error);
      }
    }

    // 🎨 Helper functions
    function getTypeColor(type) {
      const colors = {
        'MESSAGE': 'bg-blue-100 text-blue-800',
        'RESERVATION': 'bg-green-100 text-green-800',
        'ABONNEMENT': 'bg-purple-100 text-purple-800'
      };
      return colors[type] || 'bg-gray-100 text-gray-800';
    }

    function getTypeIcon(type) {
      const icons = {
        'MESSAGE': '📧',
        'RESERVATION': '📅',
        'ABONNEMENT': '👑'
      };
      return icons[type] || '🔔';
    }

    function getTypeLabel(type) {
      const labels = {
        'MESSAGE': 'Message',
        'RESERVATION': 'Réservation',
        'ABONNEMENT': 'Abonnement'
      };
      return labels[type] || 'Notification';
    }

    function formatDate(dateString) {
      const date = new Date(dateString);
      const now = new Date();
      const diffInHours = Math.floor((now - date) / (1000 * 60 * 60));
      
      if (diffInHours < 1) {
        return "Il y a quelques minutes";
      } else if (diffInHours < 24) {
        return `Il y a ${diffInHours} heure${diffInHours > 1 ? 's' : ''}`;
      } else {
        return date.toLocaleDateString('fr-FR');
      }
    }

    // ⚡ realtime
    socket.on("newNotification", (n)=>{
      console.log('🔥 New notification received:', n);
      
      // Only add if it's for current user
      if (n.id_utilisateur === userId) {
        notifications.unshift(n);
        renderNotif();
        loadBadge();
        
        // Show browser notification if permission granted
        if (Notification.permission === 'granted') {
          new Notification('Nouvelle notification', {
            body: n.contenu,
            icon: '/favicon.ico'
          });
        }
      }
    });

    // 🎬 Initialize
    document.addEventListener('DOMContentLoaded', function() {
      console.log('🚀 Initializing PRO notification system for user:', userId);
      
      // Request notification permission
      if ('Notification' in window && Notification.permission === 'default') {
        Notification.requestPermission();
      }
      
      // Initial load
      loadBadge();
      
      // Update badge every 30 seconds
      setInterval(loadBadge, 30000);
      
      // Close dropdown when clicking outside
      document.addEventListener('click', function(event) {
        const dropdown = document.getElementById("notifDropdown");
        const button = event.target.closest('button[onclick="toggleNotif()"]');
        
        if (!dropdown.contains(event.target) && !button) {
          dropdown.classList.add("hidden");
        }
      });
    });

    // Update old badge system for compatibility
    function updateNavbarNotificationBadge() {
      loadBadge();
    }
  </script>
  {{/if}}
</body>
</html>
