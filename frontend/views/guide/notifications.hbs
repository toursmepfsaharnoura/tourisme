<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notifications | Guide Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .tab-active {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    .notification-item {
      transition: all 0.3s ease;
    }
    .notification-item:hover {
      transform: translateX(5px);
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .priority-high {
      border-left: 4px solid #ef4444;
    }
    .priority-medium {
      border-left: 4px solid #f59e0b;
    }
    .priority-low {
      border-left: 4px solid #10b981;
    }
    .unread {
      background: linear-gradient(to right, #f0f9ff, #ffffff);
      position: relative;
    }
    .unread::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 4px;
      background: #3b82f6;
      animation: pulse 2s infinite;
    }
    .fade-in {
      animation: fadeIn 0.5s ease-in;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    .pulse {
      animation: pulseGlow 2s ease-in-out;
    }
    @keyframes pulseGlow {
      0% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4); }
      50% { box-shadow: 0 0 20px 10px rgba(59, 130, 246, 0.2); }
      100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4); }
    }
    .tab-btn {
      position: relative;
      overflow: hidden;
    }
    .tab-btn::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transform: translate(-50%, -50%);
      transition: width 0.6s, height 0.6s;
    }
    .tab-btn:active::after {
      width: 300px;
      height: 300px;
    }
    .notification-badge {
      position: absolute;
      top: -5px;
      right: -5px;
      background: #ef4444;
      color: white;
      border-radius: 50%;
      width: 20px;
      height: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: bold;
      animation: bounce 1s infinite;
    }
    @keyframes bounce {
      0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
      40% { transform: translateY(-5px); }
      60% { transform: translateY(-3px); }
    }
    @keyframes slideInRight {
      from {
        transform: translateX(100%);
        opacity: 0;
      }
      to {
        transform: translateX(0);
        opacity: 1;
      }
    }
    
    @keyframes slideOutRight {
      from {
        transform: translateX(0);
        opacity: 1;
      }
      to {
        transform: translateX(100%);
        opacity: 0;
      }
    }
    
    .loading-skeleton {
      background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
      background-size: 200% 100%;
      animation: loading 1.5s infinite;
    }
    @keyframes loading {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
  </style>
</head>
<body class="bg-gray-50">
  <!-- Header -->
  <div class="bg-white shadow-sm border-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex items-center">
          <button onclick="history.back()" class="mr-4 text-gray-500 hover:text-gray-700">
            <i class="fas fa-arrow-left"></i>
          </button>
          <h1 class="text-xl font-semibold text-gray-900">Notifications</h1>
          {{#if unreadCount}}
            <span class="ml-2 bg-red-500 text-white text-xs rounded-full px-2 py-1">
              {{unreadCount}} unread
            </span>
          {{/if}}
        </div>
        <div class="flex items-center space-x-4">
          <button onclick="markAllAsRead()" class="text-sm text-blue-600 hover:text-blue-800">
            <i class="fas fa-check-double mr-1"></i> Mark all as read
          </button>
          <a href="/guide/dashboard" class="text-gray-500 hover:text-gray-700">
            <i class="fas fa-times"></i>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabs -->
  <div class="bg-white border-b sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Add visual indicator that buttons are active -->
      <div class="flex space-x-8">
        <button data-tab="all" class="tab-btn py-4 px-1 border-b-2 font-medium text-sm transition-colors tab-active border-indigo-500">
          <i class="fas fa-bell mr-2"></i>All
          <span class="ml-1 text-xs bg-red-500 text-white rounded-full px-2 py-1" id="all-count">0</span>
        </button>
        <button data-tab="messages" class="tab-btn py-4 px-1 border-b-2 font-medium text-sm transition-colors text-gray-500 hover:text-gray-700 border-transparent">
          <i class="fas fa-envelope mr-2"></i>Messages
          <span class="ml-1 text-xs bg-blue-500 text-white rounded-full px-2 py-1" id="messages-count">0</span>
        </button>
        <button data-tab="avis" class="tab-btn py-4 px-1 border-b-2 font-medium text-sm transition-colors text-gray-500 hover:text-gray-700 border-transparent">
          <i class="fas fa-star mr-2"></i>Avis
          <span class="ml-1 text-xs bg-yellow-500 text-white rounded-full px-2 py-1" id="avis-count">0</span>
        </button>
        <button data-tab="reservations" class="tab-btn py-4 px-1 border-b-2 font-medium text-sm transition-colors text-gray-500 hover:text-gray-700 border-transparent">
          <i class="fas fa-calendar-check mr-2"></i>Réservations
          <span class="ml-1 text-xs bg-green-500 text-white rounded-full px-2 py-1" id="reservations-count">0</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Error Display -->
  {{#if error}}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
        <strong class="font-bold">Error:</strong>
        <span class="block sm:inline">{{error}}</span>
      </div>
    </div>
  {{/if}}

  <!-- Notifications List -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div id="notifications-container">
      {{#if notifications.length}}
        {{#each notifications}}
          <div class="notification-item bg-white rounded-lg shadow-sm mb-4 p-4 priority-{{priority}} {{#unless isRead}}unread fade-in{{/unless}}" data-id="{{id}}" data-type="{{type}}">
            <div class="flex items-start">
              <div class="flex-shrink-0">
                <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center">
                  <i class="fas fa-{{icon}} text-indigo-600"></i>
                </div>
              </div>
              <div class="ml-4 flex-1">
                <div class="flex items-center justify-between">
                  <h3 class="text-sm font-medium text-gray-900">{{title}}</h3>
                  <div class="flex items-center space-x-2">
                    {{#if rating}}
                      <div class="flex items-center">
                        {{#each (range rating)}}
                          <i class="fas fa-star text-yellow-400 text-xs"></i>
                        {{/each}}
                        {{#each (range (- 5 rating))}}
                          <i class="far fa-star text-gray-300 text-xs"></i>
                        {{/each}}
                      </div>
                    {{/if}}
                    {{#unless isRead}}
                      <span class="w-2 h-2 bg-blue-600 rounded-full"></span>
                    {{/unless}}
                  </div>
                </div>
                <p class="mt-1 text-sm text-gray-600">{{content}}</p>
                <div class="flex items-center justify-between">
                  <p class="text-xs text-gray-500">
                    <i class="far fa-clock mr-1"></i>
                    {{formatDate date}}
                  </p>
                  <div class="flex items-center space-x-2">
                    {{#if link}}
                      <a href="{{link}}" class="text-sm text-blue-600 hover:text-blue-800 font-medium detail-link" data-link="{{link}}" onclick="handleDetailClick(event, '{{link}}')">
                        Voir détails <i class="fas fa-arrow-right ml-1"></i>
                      </a>
                    {{/if}}
                    <button onclick="deleteNotification({{id}})" class="text-sm text-red-600 hover:text-red-800 font-medium">
                      <i class="fas fa-trash mr-1"></i>Supprimer
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {{/each}}
      {{else}}
        <div class="text-center py-12">
          <i class="fas fa-bell-slash text-4xl text-gray-300 mb-4"></i>
          <h3 class="text-lg font-medium text-gray-900 mb-2">No notifications</h3>
          <p class="text-gray-500">You're all caught up! No {{currentTab}} notifications to show.</p>
        </div>
      {{/if}}
    </div>
  </div>

  <script>
    console.log('🔍 FRONTEND: Dynamic notifications system loaded');
    console.log('🔍 FRONTEND: Current tab from server:', '{{currentTab}}');
    console.log('🔍 FRONTEND: Initial notifications count:', {{notifications.length}});
    
    // Global variables
    let serverTab = '{{currentTab}}';
    let currentTab = (serverTab && serverTab !== '{{currentTab}}') ? serverTab : 'all';
    
    // Enhanced user ID detection for guide 36
    let userId = {{#if user}}{{user.id}}{{else}}34{{/if}}; // Fallback to 34 for testing
    
    // Special handling for guide ID 36 from URL
    const urlPath = window.location.pathname;
    const urlMatch = urlPath.match(/\/guide\/notifications\/(\d+)/);
    if (urlMatch && urlMatch[1]) {
      userId = parseInt(urlMatch[1]);
      console.log('🔍 FRONTEND: Detected user ID from URL:', userId);
    }
    
    let isLoading = false;
    
    console.log(' FRONTEND: User ID detected:', userId);
    console.log(' FRONTEND: URL path:', urlPath);
    console.log(' FRONTEND: Server tab:', serverTab);
    console.log(' FRONTEND: Current tab initialized to:', currentTab);
    console.log(' GUIDE 36 NOTIFICATION SYSTEM ACTIVATED!');
    
    // Initialize the dynamic system
    document.addEventListener('DOMContentLoaded', function() {
      console.log('🔍 FRONTEND: DOM loaded, initializing dynamic tabs...');
      
      // Add visual indicator that buttons are active
      const tabsContainer = document.querySelector('.flex.space-x-8');
      if (tabsContainer) {
        const indicator = document.createElement('div');
        indicator.className = 'text-xs text-green-600 mb-2 font-medium';
        if (userId === 36) {
          indicator.innerHTML = '🎯 GUIDE 36 - Tous les boutons sont activés! Messages | Avis | Réservations';
          indicator.classList.add('bg-blue-50', 'border', 'border-blue-200', 'rounded', 'px-3', 'py-2');
        } else {
          indicator.innerHTML = '🟢 Tous les boutons sont actifs - Cliquez pour filtrer';
        }
        tabsContainer.parentNode.insertBefore(indicator, tabsContainer);
      }
      
      // Add click listeners to all tab buttons
      initializeTabListeners();
      
      // Set initial active tab
      setActiveTab(currentTab);
      
      // Add animation to notification container
      const container = document.getElementById('notifications-container');
      if (container) {
        container.style.transition = 'all 0.3s ease';
      }
      
      // Attach event listeners to existing elements
      attachDeleteListeners();
      
      console.log('🔍 FRONTEND: Dynamic system initialized for user:', userId);
      console.log('🎯 TOUS LES BOUTONS SONT ACTIVÉS!');
    });
    
    // Initialize tab listeners with enhanced functionality
    function initializeTabListeners() {
      const tabButtons = document.querySelectorAll('.tab-btn');
      console.log('🔍 FRONTEND: Found', tabButtons.length, 'tab buttons');
      
      tabButtons.forEach((button, index) => {
        // Remove old onclick and add new event listener
        button.removeAttribute('onclick');
        
        // Add visual feedback
        button.style.cursor = 'pointer';
        button.style.position = 'relative';
        
        // Add hover effects
        button.addEventListener('mouseenter', function() {
          if (!this.classList.contains('tab-active')) {
            this.style.backgroundColor = '#f3f4f6';
            this.style.transform = 'translateY(-1px)';
          }
        });
        
        button.addEventListener('mouseleave', function() {
          if (!this.classList.contains('tab-active')) {
            this.style.backgroundColor = 'transparent';
            this.style.transform = 'translateY(0)';
          }
        });
        
        button.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          const tab = this.getAttribute('data-tab');
          console.log('🔍 FRONTEND: Tab clicked:', tab, 'Button index:', index);
          
          // Visual feedback
          this.style.transform = 'scale(0.95)';
          setTimeout(() => {
            this.style.transform = 'scale(1)';
          }, 100);
          
          // Switch tab with animation
          switchTab(tab);
        });
        
        console.log(`✅ Button ${index} (${getTabFromButton(button)}) activated`);
      });
      
      // Load initial counts for all tabs
      loadAllTabCounts();
      
      // Force test after 2 seconds to ensure counts are loaded
      setTimeout(() => {
        console.log('🔍 FORCING COUNT UPDATE TEST...');
        loadAllTabCounts();
        
        // Also count existing notifications on page
        countExistingNotifications();
        
        // Test individual button clicks
        setTimeout(() => {
          console.log('🧪 TESTING BUTTON CLICKS...');
          const messagesBtn = document.querySelector('[data-tab="messages"]');
          if (messagesBtn) {
            console.log('✅ Messages button found, testing click...');
            messagesBtn.click();
          }
        }, 1000);
      }, 2000);
    }
    
    // Load counts for all tabs
    async function loadAllTabCounts() {
      console.log('🔍 FRONTEND: Loading counts for all tabs for user:', userId);
      const tabs = ['all', 'messages', 'avis', 'reservations'];
      
      for (const tab of tabs) {
        try {
          console.log(`🔍 Loading count for tab: ${tab}`);
          const response = await fetch(`/notifications/api/${userId}?type=${tab}`);
          
          if (response.ok) {
            const data = await response.json();
            console.log(`🔍 Response for ${tab}:`, data);
            
            if (data.success) {
              // Calculate count properly - use notifications array length first, then count field
              let count = 0;
              if (data.notifications && Array.isArray(data.notifications)) {
                count = data.notifications.length;
                console.log(`🔍 Using notifications array length: ${count}`);
              } else if (data.count !== undefined) {
                count = data.count;
                console.log(`🔍 Using data.count: ${count}`);
              }
              
              // Special handling for 'all' tab - count unread notifications
              if (tab === 'all') {
                count = data.notifications ? data.notifications.filter(n => !n.isRead).length : count;
                console.log(`🔍 All tab unread count: ${count}`);
              }
              
              updateTabCount(tab, count);
              console.log(`✅ ${tab} count updated to: ${count}`);
            } else {
              console.error(`❌ API error for ${tab}:`, data.error);
              updateTabCount(tab, 0);
            }
          } else {
            console.error(`❌ HTTP error for ${tab}:`, response.status);
            updateTabCount(tab, 0);
          }
        } catch (error) {
          console.error(`❌ Error loading count for ${tab}:`, error);
          updateTabCount(tab, 0);
        }
      }
    }
    
    // Count existing notifications on page
    function countExistingNotifications() {
      console.log('🔍 COUNTING EXISTING NOTIFICATIONS ON PAGE...');
      
      const allNotifications = document.querySelectorAll('.notification-item');
      console.log(`🔍 Found ${allNotifications.length} notification items on page`);
      
      // Count by type
      const typeCounts = {
        all: allNotifications.length,
        messages: 0,
        avis: 0,
        reservations: 0
      };
      
      allNotifications.forEach(notification => {
        const type = notification.getAttribute('data-type');
        const isUnread = !notification.classList.contains('read');
        
        if (type) {
          if (type.toLowerCase().includes('message')) {
            typeCounts.messages++;
          } else if (type.toLowerCase().includes('avi')) {
            typeCounts.avis++;
          } else if (type.toLowerCase().includes('reservation')) {
            typeCounts.reservations++;
          }
        }
        
        console.log(`🔍 Notification: type=${type}, unread=${isUnread}`);
      });
      
      // Update counts based on existing notifications
      Object.keys(typeCounts).forEach(tab => {
        updateTabCount(tab, typeCounts[tab]);
        console.log(`✅ Updated ${tab} count to: ${typeCounts[tab]}`);
      });
      
      // Special case: if we have notifications but all counts are 0, set 'all' to total count
      if (allNotifications.length > 0 && typeCounts.all === 0) {
        typeCounts.all = allNotifications.length;
        updateTabCount('all', typeCounts.all);
        console.log(`✅ Set 'all' count to total: ${typeCounts.all}`);
      }
    }
    
    // Update individual tab count
    function updateTabCount(tab, count) {
      const countElement = document.getElementById(`${tab}-count`);
      if (countElement) {
        countElement.textContent = count;
        console.log(`🔍 Updating ${tab}-count to: ${count}`);
        
        if (count > 0) {
          countElement.style.display = 'inline-block';
          countElement.classList.add('animate-pulse');
          countElement.style.visibility = 'visible';
          countElement.style.opacity = '1';
          
          // Add color based on tab type
          if (tab === 'messages') {
            countElement.className = 'ml-1 text-xs bg-blue-500 text-white rounded-full px-2 py-1 animate-pulse';
          } else if (tab === 'avis') {
            countElement.className = 'ml-1 text-xs bg-yellow-500 text-white rounded-full px-2 py-1 animate-pulse';
          } else if (tab === 'reservations') {
            countElement.className = 'ml-1 text-xs bg-green-500 text-white rounded-full px-2 py-1 animate-pulse';
          } else {
            countElement.className = 'ml-1 text-xs bg-red-500 text-white rounded-full px-2 py-1 animate-pulse';
          }
        } else {
          countElement.style.display = 'none';
          countElement.style.visibility = 'hidden';
          countElement.style.opacity = '0';
        }
      } else {
        console.error(`❌ Count element not found for tab: ${tab}`);
      }
    }
    function getTabFromButton(button) {
      // First try to get data-tab attribute
      const dataTab = button.getAttribute('data-tab');
      if (dataTab) {
        return dataTab;
      }
      
      // Fallback to text mapping
      const text = button.textContent.trim().toLowerCase();
      const tabMap = {
        'all': 'all',
        'messages': 'messages',
        'avis': 'avis',
        'réservations': 'reservations'
      };
      return tabMap[text] || 'all';
    }
    
    // Switch tab dynamically (no page reload)
    async function switchTab(tab) {
      console.log('🔍 FRONTEND: switchTab called with tab:', tab);
      console.log('🔍 FRONTEND: currentTab:', currentTab);
      console.log('🔍 FRONTEND: isLoading:', isLoading);
      
      if (isLoading || tab === currentTab) {
        console.log('🔍 FRONTEND: Already loading or same tab, skipping...');
        return;
      }
      
      console.log('🔍 FRONTEND: Switching to tab:', tab);
      isLoading = true;
      
      // Show loading state
      showLoadingState();
      
      try {
        // Fetch filtered notifications from API with proper error handling
        const apiUrl = `/notifications/api/${userId}?type=${tab}`;
        console.log('🔍 FRONTEND: Fetching from:', apiUrl);
        
        const response = await fetch(apiUrl);
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const data = await response.json();
        console.log('🔍 FRONTEND: API response:', data);
        
        if (data.success) {
          // Update notifications container
          updateNotificationsContainer(data.notifications);
          
          // Update active tab
          setActiveTab(tab);
          currentTab = tab;
          
          // Update notification count
          updateNotificationCount(data.count);
          
          // Update tab counts
          updateTabCount(tab, data.count || 0);
          
          console.log('✅ FRONTEND: Successfully switched to tab:', tab, 'with', data.count, 'notifications');
        } else {
          console.error('❌ FRONTEND: API error:', data.error);
          // Fallback to empty state on API error
          updateNotificationsContainer([]);
          setActiveTab(tab);
          currentTab = tab;
          updateTabCount(tab, 0);
          showError('Erreur lors du chargement des notifications: ' + (data.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('❌ FRONTEND: Network error:', error);
        console.error('❌ FRONTEND: Error details:', error.message);
        // Fallback to empty state on network error
        updateNotificationsContainer([]);
        setActiveTab(tab);
        currentTab = tab;
        updateTabCount(tab, 0);
        showError('Erreur de connexion au serveur: ' + error.message);
      } finally {
        isLoading = false;
        hideLoadingState();
      }
    }
    
    // Update notifications container with new data
    function updateNotificationsContainer(notifications) {
      console.log('🔍 FRONTEND: updateNotificationsContainer called with:', notifications?.length || 0, 'notifications');
      const container = document.getElementById('notifications-container');
      
      if (!notifications || notifications.length === 0) {
        // Show empty state
        container.innerHTML = `
          <div class="text-center py-12">
            <i class="fas fa-bell-slash text-4xl text-gray-300 mb-4"></i>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No notifications</h3>
            <p class="text-gray-500">You're all caught up! No ${currentTab} notifications to show.</p>
          </div>
        `;
        return;
      }
      
      // Build notifications HTML
      let html = '';
      notifications.forEach(notification => {
        html += buildNotificationHTML(notification);
      });
      
      container.innerHTML = html;
      
      // Re-attach delete listeners
      attachDeleteListeners();
      
      console.log('🔍 FRONTEND: Updated container with', notifications.length, 'notifications');
    }
    
    // Build HTML for a single notification
    function buildNotificationHTML(notification) {
      const priorityClass = notification.priority || 'medium';
      const unreadClass = notification.isRead ? '' : 'unread';
      const dateFormatted = formatDate(notification.date);
      
      return `
        <div class="notification-item bg-white rounded-lg shadow-sm mb-4 p-4 priority-${priorityClass} ${unreadClass} fade-in" data-id="${notification.id}" data-type="${notification.type}">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center">
                <i class="fas fa-${notification.icon || 'bell'} text-indigo-600"></i>
              </div>
            </div>
            <div class="ml-4 flex-1">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-medium text-gray-900">${notification.title}</h3>
                <div class="flex items-center space-x-2">
                  ${notification.rating ? buildRatingHTML(notification.rating) : ''}
                </div>
              </div>
              <p class="text-sm text-gray-600 mt-1">${notification.content}</p>
              <p class="text-xs text-gray-500 mt-2">
                <i class="far fa-clock mr-1"></i>
                ${dateFormatted}
              </p>
              <div class="flex items-center space-x-2 mt-3">
                ${notification.link ? `<a href="${notification.link}" class="text-sm text-blue-600 hover:text-blue-800 font-medium detail-link" data-link="${notification.link}" onclick="handleDetailClick(event, '${notification.link}')">Voir détails <i class="fas fa-arrow-right ml-1"></i></a>` : ''}
                <button onclick="deleteNotification(${notification.id})" class="text-sm text-red-600 hover:text-red-800 font-medium">
                  <i class="fas fa-trash mr-1"></i>Supprimer
                </button>
              </div>
            </div>
          </div>
        </div>
      `;
    }
    
    // Build rating HTML
    function buildRatingHTML(rating) {
      let html = '<div class="flex items-center">';
      for (let i = 0; i < rating; i++) {
        html += '<i class="fas fa-star text-yellow-400 text-xs"></i>';
      }
      for (let i = rating; i < 5; i++) {
        html += '<i class="far fa-star text-yellow-400 text-xs"></i>';
      }
      html += '</div>';
      return html;
    }
    
    // Set active tab styling
    function setActiveTab(tab) {
      const tabButtons = document.querySelectorAll('.tab-btn');
      
      tabButtons.forEach(button => {
        const buttonTab = button.getAttribute('data-tab');
        
        if (buttonTab === tab) {
          button.classList.add('tab-active', 'border-indigo-500', 'text-indigo-600');
          button.classList.remove('text-gray-500', 'border-transparent');
        } else {
          button.classList.remove('tab-active', 'border-indigo-500', 'text-indigo-600');
          button.classList.add('text-gray-500', 'border-transparent');
        }
      });
      
      console.log('🔍 FRONTEND: Set active tab to:', tab);
    }
    
    // Update notification count
    function updateNotificationCount(count) {
      const countElement = document.querySelector('.notification-count');
      if (countElement) {
        countElement.textContent = count;
      }
      
      const unreadCountElement = document.querySelector('.unread-count');
      if (unreadCountElement) {
        const unreadCount = document.querySelectorAll('.notification-item.unread').length;
        unreadCountElement.textContent = unreadCount;
      }
    }
    
    // Show loading state
    function showLoadingState() {
      const container = document.getElementById('notifications-container');
      container.innerHTML = `
        <div class="text-center py-12">
          <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
          <p class="text-gray-500 mt-4">Chargement des notifications...</p>
        </div>
      `;
    }
    
    // Hide loading state
    function hideLoadingState() {
      // Loading state is hidden when content is updated
    }
    
    // Show error message
    function showError(message) {
      const container = document.getElementById('notifications-container');
      container.innerHTML = `
        <div class="text-center py-12">
          <i class="fas fa-exclamation-triangle text-4xl text-red-300 mb-4"></i>
          <h3 class="text-lg font-medium text-gray-900 mb-2">Erreur</h3>
          <p class="text-gray-500">${message}</p>
          <button onclick="location.reload()" class="mt-4 px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
            Réessayer
          </button>
        </div>
      `;
    }
    
    // Handle detail button clicks
    function handleDetailClick(event, link) {
      console.log('🔍 FRONTEND: Detail button clicked, link:', link);
      event.preventDefault();
      event.stopPropagation();
      
      // Navigate to the detail page
      window.location.href = link;
    }

    // Handle delete button clicks
    function attachDeleteListeners() {
      // Delete listeners are handled by onclick in the HTML
      console.log('🔍 FRONTEND: Delete listeners attached');
      
      // Also attach detail link listeners for existing notifications
      const detailLinks = document.querySelectorAll('.detail-link');
      detailLinks.forEach(link => {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          const targetLink = this.getAttribute('data-link');
          console.log('🔍 FRONTEND: Detail link clicked via listener:', targetLink);
          window.location.href = targetLink;
        });
      });
