    // Format date function
    function formatDate(dateString) {
      const date = new Date(dateString);
      return date.toLocaleDateString('fr-FR', { 
        day: '2-digit', 
        month: '2-digit', 
        year: 'numeric' 
      });
    }

    // Mark notification as read
    async function markAsRead(notificationId, type) {
      console.log('🔍 FRONTEND: Marking notification as read:', notificationId, type);
      try {
        const response = await fetch('/guide/notifications/mark-read', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ notificationId, type }),
        });

        if (response.ok) {
          const notificationElement = document.querySelector(`[data-id="${notificationId}"]`);
          if (notificationElement) {
            notificationElement.classList.remove('unread');
            const unreadIndicator = notificationElement.querySelector('.bg-blue-600');
            if (unreadIndicator) {
              unreadIndicator.remove();
            }
          }
        }
      } catch (error) {
        console.error('Error marking notification as read:', error);
      }
    }

    // Mark all notifications as read
    async function markAllAsRead() {
      console.log('🔍 FRONTEND: Marking all notifications as read');
      
      try {
        const response = await fetch('/notifications/read-all', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ userId }),
        });

        if (response.ok) {
          // Remove unread styling from all notifications
          document.querySelectorAll('.unread').forEach(element => {
            element.classList.remove('unread');
            const unreadIndicator = element.querySelector('.bg-blue-600');
            if (unreadIndicator) {
              unreadIndicator.remove();
            }
          });

          // Update unread count badge
          const unreadBadge = document.querySelector('.bg-red-500');
          if (unreadBadge) {
            unreadBadge.style.display = 'none';
          }
          
          console.log('✅ FRONTEND: All notifications marked as read');
        } else {
          console.error('❌ FRONTEND: Failed to mark all as read');
        }
      } catch (error) {
        console.error('❌ FRONTEND: Error marking all notifications as read:', error);
      }
    }

    // Delete notification
    async function deleteNotification(notificationId) {
      console.log('🔍 FRONTEND: Deleting notification:', notificationId);
      if (!confirm('Êtes-vous sûr de vouloir supprimer cette notification ?')) {
        return;
      }

      try {
        console.log('🔍 FRONTEND: Sending DELETE request to /notifications/' + notificationId);
        const response = await fetch(`/notifications/${notificationId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
          },
        });

        console.log('🔍 FRONTEND: Delete response status:', response.status);
        
        if (response.ok) {
          console.log('✅ FRONTEND: Delete successful, removing element from DOM');
          const notificationElement = document.querySelector(`[data-id="${notificationId}"]`);
          if (notificationElement) {
            notificationElement.style.transition = 'all 0.3s ease';
            notificationElement.style.opacity = '0';
            notificationElement.style.transform = 'translateX(100%)';
            
            setTimeout(() => {
              notificationElement.remove();
              
              // Update unread count after deletion
              updateUnreadCount();
              
              // Check if there are no more notifications
              const remainingNotifications = document.querySelectorAll('.notification-item');
              console.log('🔍 FRONTEND: Remaining notifications:', remainingNotifications.length);
              if (remainingNotifications.length === 0) {
                document.getElementById('notifications-container').innerHTML = `
                  <div class="text-center py-12">
                    <i class="fas fa-bell-slash text-4xl text-gray-300 mb-4"></i>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">No notifications</h3>
                    <p class="text-gray-500">You're all caught up! No notifications to show.</p>
                  </div>
                `;
              }
            }, 300);
          } else {
            console.log('❌ FRONTEND: Could not find notification element in DOM');
            // Refresh the current tab to update the view
            refreshCurrentTab();
          }
        } else {
          console.error('❌ FRONTEND: Delete failed with status:', response.status);
          const errorData = await response.json().catch(() => ({}));
          alert('Erreur lors de la suppression de la notification: ' + (errorData.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('❌ FRONTEND: Error deleting notification:', error);
        alert('Erreur lors de la suppression de la notification: ' + error.message);
      }
    }

    // Real-time notifications with Socket.io
    let socket = null;
    
    // Initialize Socket.io connection
    function initializeSocket() {
      try {
        console.log('🔍 FRONTEND: Initializing Socket.io...');
        socket = io();
        
        // Connection successful
        socket.on('connect', () => {
          console.log('✅ FRONTEND: Socket.io connected successfully');
          
          // Join guide's notification room
          socket.emit('joinGuideNotifications', userId);
          socket.emit('joinUserRoom', userId);
          
          console.log('🔍 FRONTEND: Joined notification rooms for user:', userId);
        });
        
        // Listen for new notifications
        socket.on('newNotification', (notification) => {
          console.log('🔔 FRONTEND: New notification received:', notification);
          
          // Check if notification belongs to current user
          if (notification.user_id === userId || notification.id_utilisateur === userId) {
            addNewNotification(notification);
            updateUnreadCount();
            
            // Show toast notification
            showNotificationToast(notification);
          }
        });
        
        // Listen for notification updates
        socket.on('notificationUpdate', (data) => {
          console.log('🔄 FRONTEND: Notification update received:', data);
          if (data.type === currentTab || currentTab === 'all') {
            refreshCurrentTab();
          }
        });
        
        // Listen for all notifications read
        socket.on('allNotificationsRead', (data) => {
          console.log('📖 FRONTEND: All notifications marked as read:', data);
          if (data.userId === userId) {
            // Remove unread styling from all notifications
            document.querySelectorAll('.unread').forEach(element => {
              element.classList.remove('unread');
              const unreadIndicator = element.querySelector('.bg-blue-600');
              if (unreadIndicator) {
                unreadIndicator.remove();
              }
            });
            
            // Update unread count
            updateUnreadCount();
          }
        });
        
        // Listen for notification read events
        socket.on('notificationRead', (data) => {
          console.log('✅ FRONTEND: Notification marked as read:', data);
          const notificationElement = document.querySelector(`[data-id="${data.id}"]`);
          if (notificationElement) {
            notificationElement.classList.remove('unread');
            const unreadIndicator = notificationElement.querySelector('.bg-blue-600');
            if (unreadIndicator) {
              unreadIndicator.remove();
            }
            updateUnreadCount();
          }
        });
        
        // Connection error handling
        socket.on('connect_error', (err) => {
          console.error('❌ FRONTEND: Socket.io connection error:', err);
          // Fallback to polling
          startPolling();
        });
        
        // Disconnection handling
        socket.on('disconnect', () => {
          console.log('❌ FRONTEND: Socket.io disconnected');
          // Start polling as fallback
          startPolling();
        });
        
      } catch (error) {
        console.log('❌ FRONTEND: Socket.io not available, falling back to polling');
        startPolling();
      }
    }
    
    // Add new notification to the UI
    function addNewNotification(notification) {
      const container = document.getElementById('notifications-container');
      
      // If container is empty, remove empty state
      if (container.querySelector('.text-center')) {
        container.innerHTML = '';
      }
      
      // Create notification element
      const notificationElement = document.createElement('div');
      notificationElement.innerHTML = buildNotificationHTML(notification);
      const newNotification = notificationElement.firstElementChild;
      
      // Add to top of list with animation
      container.insertBefore(newNotification, container.firstChild);
      
      // Highlight new notification
      newNotification.classList.add('fade-in', 'unread');
      setTimeout(() => {
        newNotification.classList.add('pulse');
        setTimeout(() => {
          newNotification.classList.remove('pulse');
        }, 2000);
      }, 100);
      
      // Update tab counts
      loadAllTabCounts();
    }
    
    // Update unread count
    function updateUnreadCount() {
      const unreadElements = document.querySelectorAll('.notification-item.unread');
      const count = unreadElements.length;
      
      console.log('🔍 FRONTEND: Updating unread count to:', count);
      
      // Update header badge
      const badge = document.querySelector('.bg-red-500');
      if (badge) {
        if (count > 0) {
          badge.textContent = `${count} unread`;
          badge.style.display = 'inline-block';
        } else {
          badge.style.display = 'none';
        }
      }
      
      // Update any other count displays
      const countElements = document.querySelectorAll('.notification-count');
      countElements.forEach(element => {
        element.textContent = count;
      });
    }
    
    // Start polling if Socket.io is not available
    function startPolling() {
      console.log('🔄 Starting polling for notifications...');
      setInterval(() => {
        refreshCurrentTab();
      }, 10000); // Poll every 10 seconds
    }
    
    // Refresh current tab
    async function refreshCurrentTab() {
      if (isLoading) return;
      
      console.log('🔍 FRONTEND: Refreshing current tab:', currentTab);
      
      try {
        const response = await fetch(`/notifications/api/${userId}?type=${currentTab}`);
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const data = await response.json();
        
        if (data.success) {
          updateNotificationsContainer(data.notifications);
          updateUnreadCount();
          updateTabCount(currentTab, data.count || 0);
          console.log('✅ FRONTEND: Successfully refreshed tab with', data.count, 'notifications');
          
          // Also refresh all tab counts periodically
          if (Math.random() < 0.3) { // 30% chance to refresh all counts
            loadAllTabCounts();
          }
        } else {
          console.error('❌ FRONTEND: Error refreshing notifications:', data.error);
        }
      } catch (error) {
        console.error('❌ FRONTEND: Error refreshing notifications:', error);
      }
    }
    
    // Show notification toast
    function showNotificationToast(notification) {
      // Create toast element
      const toast = document.createElement('div');
      toast.className = 'fixed top-4 right-4 bg-white border border-gray-200 rounded-lg shadow-lg p-4 z-50 max-w-sm';
      toast.style.animation = 'slideInRight 0.3s ease-out';
      
      const icon = getIconForType(notification.type || 'message');
      const title = notification.title || 'Nouvelle notification';
      const content = notification.content || notification.contenu || 'Vous avez une nouvelle notification';
      
      toast.innerHTML = `
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center">
              <i class="fas fa-${icon} text-indigo-600"></i>
            </div>
          </div>
          <div class="ml-3 flex-1">
            <h4 class="text-sm font-medium text-gray-900">${title}</h4>
            <p class="text-sm text-gray-600 mt-1">${content}</p>
            <div class="mt-2">
              <button onclick="this.parentElement.parentElement.parentElement.remove()" class="text-xs text-gray-500 hover:text-gray-700">
                Fermer
              </button>
            </div>
          </div>
        </div>
      `;
      
      document.body.appendChild(toast);
      
      // Auto-remove after 5 seconds
      setTimeout(() => {
        if (toast.parentElement) {
          toast.style.animation = 'slideOutRight 0.3s ease-in';
          setTimeout(() => toast.remove(), 300);
        }
      }, 5000);
    }
    
    // Helper function to get icon for type
    function getIconForType(type) {
      const icons = {
        'message': 'envelope',
        'avis': 'star',
        'reservation': 'calendar-check',
        'MESSAGE': 'envelope',
        'AVIS': 'star',
        'RESERVATION': 'calendar-check',
        'CV': 'file-alt',
        'PAIEMENT': 'credit-card',
        'ABONNEMENT': 'crown'
      };
      return icons[type] || 'bell';
    }

    // Initialize Socket.io when page loads
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(() => {
        initializeSocket();
      }, 1000);
    });

