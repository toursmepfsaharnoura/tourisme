<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Avis | Guide Panel</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .rating-stars {
      color: #fbbf24;
    }
    .review-card {
      transition: all 0.3s ease;
    }
    .review-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }
  </style>
</head>
<body class="bg-gray-50">
  <div class="min-h-screen">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center">
            <button onclick="history.back()" class="mr-4 text-gray-500 hover:text-gray-700">
              <i class="fas fa-arrow-left"></i>
            </button>
            <h1 class="text-xl font-semibold text-gray-900">Avis des touristes</h1>
            <span class="ml-2 bg-blue-500 text-white text-xs rounded-full px-2 py-1">
              {{avis.length}} avis
            </span>
          </div>
          <a href="/guide/dashboard" class="text-gray-500 hover:text-gray-700">
            <i class="fas fa-times"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      {{#if avis.length}}
        <!-- Statistics -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 bg-yellow-100 rounded-full">
                <i class="fas fa-star text-yellow-600 text-xl"></i>
              </div>
              <div class="ml-4">
                <p class="text-sm text-gray-500">Note moyenne</p>
                <p class="text-2xl font-bold text-gray-900">
                  {{#each avis}}
                    {{#if @first}}{{note}}{{/if}}
                  {{/each}}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 bg-green-100 rounded-full">
                <i class="fas fa-thumbs-up text-green-600 text-xl"></i>
              </div>
              <div class="ml-4">
                <p class="text-sm text-gray-500">Avis positifs</p>
                <p class="text-2xl font-bold text-gray-900">
                  {{#each avis}}
                    {{#if (gte note 3)}}{{#if @first}}1{{else}}{{add @index 1}}{{/if}}{{/if}}
                  {{/each}}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 bg-blue-100 rounded-full">
                <i class="fas fa-calendar text-blue-600 text-xl"></i>
              </div>
              <div class="ml-4">
                <p class="text-sm text-gray-500">Ce mois</p>
                <p class="text-2xl font-bold text-gray-900">
                  {{#each avis}}
                    {{#if (isThisMonth date_creation)}}{{#if @first}}1{{else}}{{add @index 1}}{{/if}}{{/if}}
                  {{/each}}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Reviews List -->
        <div class="space-y-4">
          {{#each avis}}
            <div class="review-card bg-white rounded-lg shadow-sm p-6">
              <div class="flex items-start justify-between">
                <div class="flex items-start">
                  <div class="flex-shrink-0">
                    <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center">
                      <i class="fas fa-user text-indigo-600"></i>
                    </div>
                  </div>
                  <div class="ml-4 flex-1">
                    <div class="flex items-center justify-between">
                      <div>
                        <h3 class="text-lg font-medium text-gray-900">{{tourist.nom_complet}}</h3>
                        <p class="text-sm text-gray-500">{{plan.titre}}</p>
                      </div>
                      <div class="text-right">
                        <div class="rating-stars">
                          {{#times note}}
                            <i class="fas fa-star"></i>
                          {{/times}}
                          {{#times (- 5 note)}}
                            <i class="far fa-star"></i>
                          {{/times}}
                        </div>
                        <p class="text-xs text-gray-500 mt-1">
                          <i class="far fa-clock mr-1"></i>
                          {{formatDate date_creation}}
                        </p>
                      </div>
                    </div>
                    <div class="mt-3">
                      <p class="text-gray-700">{{commentaire}}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="text-center py-12">
          <i class="fas fa-star text-4xl text-gray-300 mb-4"></i>
          <h3 class="text-lg font-medium text-gray-900 mb-2">Aucun avis</h3>
          <p class="text-gray-500">Vous n'avez pas encore reçu d'avis pour vos circuits.</p>
        </div>
      {{/if}}
    </div>
  </div>

  <script>
    // Auto-refresh every 30 seconds
    setInterval(() => {
      window.location.reload();
    }, 30000);

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        window.location.href = '/guide/dashboard';
      }
    });
  </script>
</body>
</html>
