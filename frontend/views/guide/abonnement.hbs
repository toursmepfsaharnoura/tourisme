<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Abonnement | Guide Panel</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .gradient-bg {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    .card-hover {
      transition: all 0.3s ease;
    }
    .card-hover:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }
    .premium-badge {
      background: linear-gradient(45deg, #fbbf24, #f59e0b);
      color: white;
    }
  </style>
</head>
<body class="bg-gray-50">
  <div class="min-h-screen">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center">
            <button onclick="history.back()" class="mr-4 text-gray-500 hover:text-gray-700">
              <i class="fas fa-arrow-left"></i>
            </button>
            <h1 class="text-xl font-semibold text-gray-900">Mon Abonnement</h1>
          </div>
          <a href="/guide/dashboard" class="text-gray-500 hover:text-gray-700">
            <i class="fas fa-times"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      {{#if user.abonnement_actif}}
        <!-- Active Subscription -->
        <div class="bg-gradient-to-r from-green-500 to-emerald-600 rounded-2xl p-8 text-white mb-8">
          <div class="flex items-center justify-between">
            <div>
              <div class="flex items-center mb-4">
                <i class="fas fa-crown text-3xl mr-3"></i>
                <h2 class="text-2xl font-bold">Abonnement Premium Actif</h2>
              </div>
              <p class="text-lg opacity-90 mb-2">
                Profitez de tous les avantages de votre abonnement
              </p>
              {{#if user.abonnement}}
                <p class="text-sm opacity-75">
                  Valide jusqu'au : {{formatDate user.abonnement_fin}}
                </p>
              {{/if}}
            </div>
            <div class="text-center">
              <div class="premium-badge px-4 py-2 rounded-full text-sm font-bold mb-4">
                ACTIF
              </div>
              <div class="text-3xl font-bold">30 TND</div>
              <div class="text-sm opacity-75">/ mois</div>
            </div>
          </div>
        </div>

        <!-- Benefits -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="bg-white rounded-lg shadow-sm p-6 card-hover">
            <div class="flex items-center mb-4">
              <div class="p-3 bg-blue-100 rounded-full">
                <i class="fas fa-map-marked-alt text-blue-600 text-xl"></i>
              </div>
              <h3 class="ml-3 text-lg font-semibold">Plans Illimités</h3>
            </div>
            <p class="text-gray-600">
              Créez autant de circuits touristiques que vous le souhaitez
            </p>
          </div>

          <div class="bg-white rounded-lg shadow-sm p-6 card-hover">
            <div class="flex items-center mb-4">
              <div class="p-3 bg-green-100 rounded-full">
                <i class="fas fa-users text-green-600 text-xl"></i>
              </div>
              <h3 class="ml-3 text-lg font-semibold">Réservations</h3>
            </div>
            <p class="text-gray-600">
              Gérez les réservations des touristes sans aucune limitation
            </p>
          </div>

          <div class="bg-white rounded-lg shadow-sm p-6 card-hover">
            <div class="flex items-center mb-4">
              <div class="p-3 bg-purple-100 rounded-full">
                <i class="fas fa-star text-purple-600 text-xl"></i>
              </div>
              <h3 class="ml-3 text-lg font-semibold">Avis & Notation</h3>
            </div>
            <p class="text-gray-600">
              Recevez et gérez les avis des touristes pour améliorer vos services
            </p>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/guide/create-plan" class="flex-1 bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-indigo-700 transition-colors">
            <i class="fas fa-plus mr-2"></i>
            Créer un nouveau plan
          </a>
          <a href="/guide/plans" class="flex-1 bg-gray-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-gray-700 transition-colors">
            <i class="fas fa-list mr-2"></i>
            Voir mes plans
          </a>
        </div>

        <!-- Subscription History -->
        {{#if user.abonnements}}
          <div class="mt-12">
            <h3 class="text-xl font-bold text-gray-900 mb-6">Historique des abonnements</h3>
            <div class="bg-white rounded-lg shadow-sm overflow-hidden">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      Période
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      Statut
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      Montant
                    </th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  {{#each user.abonnements}}
                    <tr>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                        {{formatDate date_debut}} - {{formatDate date_fin}}
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                          {{#eq statut 'ACTIF'}}bg-green-100 text-green-800
                          {{else}}bg-gray-100 text-gray-800{{/eq}}">
                          {{statut}}
                        </span>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                        30 TND
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
        {{/if}}

      {{else}}
        <!-- No Active Subscription -->
        <div class="text-center py-12">
          <div class="mb-8">
            <i class="fas fa-crown text-6xl text-gray-300 mb-4"></i>
            <h2 class="text-3xl font-bold text-gray-900 mb-4">Abonnement Premium</h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
              Accédez à toutes les fonctionnalités pour développer votre activité de guide touristique
            </p>
          </div>

          <!-- Pricing Card -->
          <div class="max-w-md mx-auto mb-8">
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden card-hover">
              <div class="gradient-bg p-8 text-white">
                <h3 class="text-2xl font-bold mb-2">Guide Premium</h3>
                <div class="text-4xl font-bold mb-2">30 TND</div>
                <div class="text-sm opacity-75">par mois</div>
              </div>
              <div class="p-8">
                <ul class="space-y-4 mb-8">
                  <li class="flex items-center">
                    <i class="fas fa-check text-green-500 mr-3"></i>
                    <span>Création illimitée de circuits</span>
                  </li>
                  <li class="flex items-center">
                    <i class="fas fa-check text-green-500 mr-3"></i>
                    <span>Gestion des réservations</span>
                  </li>
                  <li class="flex items-center">
                    <i class="fas fa-check text-green-500 mr-3"></i>
                    <span>Systeme d'avis et notation</span>
                  </li>
                  <li class="flex items-center">
                    <i class="fas fa-check text-green-500 mr-3"></i>
                    <span>Support prioritaire</span>
                  </li>
                </ul>
                <a href="/guide/paiement" class="w-full bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-indigo-700 transition-colors block text-center">
                  <i class="fas fa-credit-card mr-2"></i>
                  Activer mon abonnement
                </a>
              </div>
            </div>
          </div>
        </div>
      {{/if}}
    </div>
  </div>

  <script>
    // Auto-refresh every 30 seconds
    setInterval(() => {
      window.location.reload();
    }, 30000);

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        window.location.href = '/guide/dashboard';
      }
    });
  </script>
</body>
</html>