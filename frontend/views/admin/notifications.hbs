<!DOCTYPE html>
<html>
<head>
  <title>Gestion des Notifications - Admin</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="/socket.io/socket.io.js"></script>
  <style>
    .notification-item {
      @apply bg-white border rounded-lg p-4 mb-3 transition-all hover:shadow-md;
    }
    .notification-item.unread {
      @apply border-l-4 border-l-indigo-500 bg-indigo-50;
    }
    .notification-item.read {
      @apply opacity-75;
    }
    .notification-icon {
      @apply w-12 h-12 rounded-full flex items-center justify-center text-white mr-4;
    }
    .message-type { @apply bg-blue-500; }
    .avis-type { @apply bg-yellow-500; }
    .reservation-type { @apply bg-green-500; }
    .paiement-type { @apply bg-purple-500; }
    .abonnement-type { @apply bg-pink-500; }
    .cv-type { @apply bg-orange-500; }
    .default-type { @apply bg-gray-500; }
    .notification-content {
      @apply flex-1;
    }
    .notification-header {
      @apply flex justify-between items-start mb-2;
    }
    .notification-title {
      @apply font-semibold text-gray-900;
    }
    .notification-time {
      @apply text-sm text-gray-500;
    }
    .notification-text {
      @apply text-gray-700 mb-3;
    }
    .notification-actions {
      @apply flex gap-2;
    }
    .notification-actions button {
      @apply px-3 py-1 text-sm rounded transition-colors;
    }
    .mark-read-btn {
      @apply bg-green-500 text-white hover:bg-green-600;
    }
    .delete-notification-btn {
      @apply bg-red-500 text-white hover:bg-red-600;
    }
    .empty-notifications {
      @apply text-center py-12 text-gray-500;
    }
    .empty-icon {
      @apply text-4xl mb-4 opacity-50;
    }
    .notification-tab {
      @apply px-4 py-2 rounded-lg transition-colors;
    }
    .notification-tab.active {
      @apply bg-indigo-600 text-white;
    }
    .notification-tab:not(.active) {
      @apply bg-gray-200 text-gray-700 hover:bg-gray-300;
    }
    .notification-badge {
      @apply absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center;
    }
    .notification-toast {
      @apply fixed top-4 right-4 bg-white border-l-4 border-l-indigo-500 rounded-lg shadow-lg p-4 z-50 max-w-sm;
      animation: slideIn 0.3s ease-out;
    }
    .notification-toast.important {
      @apply border-l-red-500 bg-red-50;
      animation: slideInPulse 0.5s ease-out;
    }
    @keyframes slideIn {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    @keyframes slideInPulse {
      0% { transform: translateX(100%); opacity: 0; }
      50% { transform: translateX(0); opacity: 1; }
      51% { transform: translateX(-5px); }
      100% { transform: translateX(0); opacity: 1; }
    }
    .toast-content {
      @apply flex items-start;
    }
    .toast-icon {
      @apply text-2xl mr-3;
    }
    .toast-text {
      @apply flex-1;
    }
    .toast-close {
      @apply ml-4 text-gray-400 hover:text-gray-600;
    }
  </style>
</head>
<body class="bg-gray-50">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="w-64 bg-gradient-to-b from-indigo-600 to-purple-700 text-white">
      <div class="p-6">
        <h2 class="text-2xl font-bold text-center mb-8">Admin Panel</h2>
        <nav class="space-y-2">
          <a href="/admin/dashboard" class="block px-4 py-3 rounded-lg hover:bg-white/20 transition-colors">
            <i class="fas fa-tachometer-alt mr-3"></i>Dashboard
          </a>
          <a href="/admin/guides" class="block px-4 py-3 rounded-lg hover:bg-white/20 transition-colors">
            <i class="fas fa-users mr-3"></i>Guides
          </a>
          <a href="/admin/messages" class="block px-4 py-3 rounded-lg hover:bg-white/20 transition-colors">
            <i class="fas fa-envelope mr-3"></i>Messages
          </a>
          <a href="/admin/notifications" class="block px-4 py-3 rounded-lg bg-white/20 relative">
            <i class="fas fa-bell mr-3"></i>Notifications
            <span class="notification-badge" id="notification-badge" style="display: none;">0</span>
          </a>
        </nav>
      </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 overflow-y-auto">
      <div class="p-8">
        <!-- Header -->
        <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
          <div class="flex justify-between items-center">
            <div>
              <h1 class="text-3xl font-bold text-gray-900">Notifications</h1>
              <p class="text-gray-600 mt-2">Suivez toutes les activités en temps réel</p>
            </div>
            <button onclick="markAllRead()" class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition-colors">
              <i class="fas fa-check-double mr-2"></i>Tout marquer comme lu
            </button>
          </div>
        </div>

        <!-- Statistics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
          <div class="bg-white rounded-lg shadow-sm p-6">
            <div class="flex items-center">
              <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-bell text-blue-600"></i>
              </div>
              <div class="ml-4">
                <p class="text-sm text-gray-600">Total Notifications</p>
                <p class="text-2xl font-bold text-gray-900" id="totalCount">0</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-lg shadow-sm p-6">
            <div class="flex items-center">
              <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-envelope text-green-600"></i>
              </div>
              <div class="ml-4">
                <p class="text-sm text-gray-600">Messages</p>
                <p class="text-2xl font-bold text-gray-900" id="messageCount">0</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-lg shadow-sm p-6">
            <div class="flex items-center">
              <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-star text-yellow-600"></i>
              </div>
              <div class="ml-4">
                <p class="text-sm text-gray-600">Avis</p>
                <p class="text-2xl font-bold text-gray-900" id="avisCount">0</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-lg shadow-sm p-6">
            <div class="flex items-center">
              <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-crown text-purple-600"></i>
              </div>
              <div class="ml-4">
                <p class="text-sm text-gray-600">Abonnements</p>
                <p class="text-2xl font-bold text-gray-900" id="abonnementCount">0</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Tabs -->
        <div class="bg-white rounded-xl shadow-sm mb-6">
          <div class="p-6 border-b">
            <div class="flex space-x-2">
              <button class="notification-tab active" data-tab="all">
                <i class="fas fa-inbox mr-2"></i>Tout
              </button>
              <button class="notification-tab" data-tab="messages">
                <i class="fas fa-envelope mr-2"></i>Messages
              </button>
              <button class="notification-tab" data-tab="avis">
                <i class="fas fa-star mr-2"></i>Avis
              </button>
              <button class="notification-tab" data-tab="reservations">
                <i class="fas fa-calendar-check mr-2"></i>Réservations
              </button>
              <button class="notification-tab" data-tab="paiements">
                <i class="fas fa-credit-card mr-2"></i>Paiements
              </button>
              <button class="notification-tab" data-tab="abonnements">
                <i class="fas fa-crown mr-2"></i>Abonnements
              </button>
            </div>
          </div>
        </div>

        <!-- Notifications List -->
        <div class="bg-white rounded-xl shadow-sm">
          <div class="p-6">
            <div id="notifications-container" class="space-y-4">
              <!-- Notifications will be loaded here -->
              <div class="text-center py-8 text-gray-500">
                <i class="fas fa-spinner fa-spin text-3xl mb-4"></i>
                <p>Chargement des notifications...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Create Notification Modal -->
  <div id="createModal" class="fixed inset-0 bg-black/50 hidden z-50">
    <div class="flex items-center justify-center h-full p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
        <h3 class="text-xl font-bold text-gray-900 mb-4">Créer une Notification</h3>
        <form id="createForm">
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">Type</label>
            <select name="type" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
              <option value="">Sélectionner un type</option>
              <option value="message">Message</option>
              <option value="avis">Avis</option>
              <option value="reservation">Réservation</option>
              <option value="paiement">Paiement</option>
              <option value="abonnement">Abonnement</option>
              <option value="cv">CV</option>
            </select>
          </div>
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">Guide</label>
            <select name="guide_id" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
              <option value="">Sélectionner un guide</option>
            </select>
          </div>
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">Titre</label>
            <input type="text" name="title" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
          </div>
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-2">Message</label>
            <textarea name="message" required rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500"></textarea>
          </div>
          <div class="flex justify-end space-x-3">
            <button type="button" onclick="closeCreateModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200">
              Annuler
            </button>
            <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
              Créer
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    // Load guides and notifications
    let guides = [];
    let notifications = [];

    async function loadGuides() {
      try {
        const response = await fetch('/admin/guides/api');
        if (response.ok) {
          guides = await response.json();
          const select = document.querySelector('select[name="guide_id"]');
          select.innerHTML = '<option value="">Sélectionner un guide</option>';
          guides.forEach(guide => {
            select.innerHTML += `<option value="${guide.id}">${guide.nom_complet}</option>`;
          });
        }
      } catch (error) {
        console.error('Error loading guides:', error);
        alert('Erreur lors de la suppression');
      }
    }

    async function loadNotifications() {
      try {
        const response = await fetch('/notifications/all');
        if (response.ok) {
          notifications = await response.json();
          displayNotifications();
          updateStatistics();
        }
      } catch (error) {
        console.error('Error loading notifications:', error);
      }
    }

    function displayNotifications() {
      const container = document.getElementById('notificationsList');
      
      if (notifications.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8">
            <i class="fas fa-bell-slash text-4xl text-gray-300 mb-4"></i>
            <p class="text-gray-500">Aucune notification trouvée</p>
          </div>
        `;
        return;
      }

      container.innerHTML = notifications.map(notif => {
        // Parse content to extract title and message
        const [title, ...messageParts] = notif.contenu.split(': ');
        const message = messageParts.join(': ') || notif.contenu;
        
        return `
        <div class="border rounded-lg p-4 hover:bg-gray-50 transition-colors">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center mb-2">
                <span class="px-2 py-1 text-xs rounded-full ${getTypeColor(notif.type)}">
                  ${notif.type}
                </span>
                <span class="ml-2 text-sm text-gray-500">
                  ${new Date(notif.date_creation).toLocaleDateString('fr-FR')}
                </span>
                <span class="ml-2 px-2 py-1 text-xs rounded-full ${notif.est_vu ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                  ${notif.est_vu ? 'Lu' : 'Non lu'}
                </span>
              </div>
              <h4 class="font-semibold text-gray-900">${title || notif.type}</h4>
              <p class="text-gray-600 mt-1">${message}</p>
              <p class="text-sm text-gray-500 mt-2">
                Guide: ${notif.guide_name || `ID: ${notif.id_utilisateur}`} ${notif.lien ? `| Lien: ${notif.lien}` : ''}
              </p>
            </div>
            <button onclick="deleteNotification(${notif.id})" class="ml-4 text-red-600 hover:text-red-800">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </div>
      `;
      }).join('');
    }

    function getTypeColor(type) {
      const colors = {
        message: 'bg-blue-100 text-blue-800',
        avis: 'bg-yellow-100 text-yellow-800',
        reservation: 'bg-green-100 text-green-800',
        paiement: 'bg-purple-100 text-purple-800',
        abonnement: 'bg-indigo-100 text-indigo-800'
      };
      return colors[type] || 'bg-gray-100 text-gray-800';
    }

    function updateStatistics() {
      document.getElementById('totalCount').textContent = notifications.length;
      document.getElementById('messageCount').textContent = notifications.filter(n => n.type === 'MESSAGE').length;
      document.getElementById('avisCount').textContent = notifications.filter(n => n.type === 'AVIS' || n.type === 'RESERVATION').length;
      document.getElementById('abonnementCount').textContent = notifications.filter(n => n.type === 'ABONNEMENT').length;
    }

    function openCreateModal() {
      document.getElementById('createModal').classList.remove('hidden');
    }

    function closeCreateModal() {
      document.getElementById('createModal').classList.add('hidden');
      document.getElementById('createForm').reset();
    }

    async function createNotification(e) {
      e.preventDefault();
      const formData = new FormData(e.target);
      
      try {
        const response = await fetch('/notifications/create', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(Object.fromEntries(formData)),
        });

        if (response.ok) {
          closeCreateModal();
          loadNotifications();
          alert('Notification créée avec succès!');
        } else {
          alert('Erreur lors de la création de la notification');
        }
      } catch (error) {
        console.error('Error creating notification:', error);
        alert('Erreur lors de la création de la notification');
      }
    }

    async function deleteNotification(id) {
      if (!confirm('Êtes-vous sûr de vouloir supprimer cette notification ?')) {
        return;
      }

      try {
        const response = await fetch(`/notifications/${id}`, {
          method: 'DELETE',
        });

        if (response.ok) {
          loadNotifications();
        } else {
          alert('Erreur lors de la suppression');
        }
      } catch (error) {
        console.error('Error deleting notification:', error);
        alert('Erreur lors de la suppression');
      }
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      loadGuides();
      loadNotifications();
      document.getElementById('createForm').addEventListener('submit', createNotification);
    });
  </script>
</body>
</html>
