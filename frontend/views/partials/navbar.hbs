              Inscription
            </a>
          {{/if}}
        </div>
      </div>
      
      <!-- Mobile Notification Button -->
      {{#if user}}
      <button onclick="toggleNotif()" class="lg:hidden text-gray-700 hover:text-ocean-blue transition-colors duration-300 p-2 rounded-lg hover:bg-gray-50 relative" title="Notifications">
        <i class="fas fa-bell text-lg"></i>
        <span id="notifBadgeMobileIcon" class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center font-bold" style="display: none;">0</span>
      </button>
      {{/if}}
      
      <!-- Mobile Menu Button -->
      <button class="lg:hidden text-gray-700 hover:text-ocean-blue transition-colors duration-300 p-2 rounded-lg hover:bg-gray-50">
        <i class="fas fa-bars text-xl"></i>
      </button>
