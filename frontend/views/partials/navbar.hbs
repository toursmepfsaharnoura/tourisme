          <a href="/" class="text-gray-900 hover:text-ocean-blue transition-colors duration-300 font-medium flex items-center space-x-2">
            <i class="fas fa-home text-sm"></i>
            <span>Accueil</span>
          </a>
          <a href="/touriste/gouvernorat/1" class="text-gray-900 hover:text-ocean-blue transition-colors duration-300 font-medium flex items-center space-x-2">
            <i class="fas fa-map-marked-alt text-sm"></i>
            <span>Destinations</span>
          </a>
          <a href="/plans" class="text-gray-900 hover:text-ocean-blue transition-colors duration-300 font-medium flex items-center space-x-2">
            <i class="fas fa-route text-sm"></i>
            <span>Circuits</span>
          </a>
          <a href="/guides" class="text-gray-900 hover:text-ocean-blue transition-colors duration-300 font-medium flex items-center space-x-2">
            <i class="fas fa-user-tie text-sm"></i>
            <span>Guides</span>
          </a>
          <a href="/ai/chat-interactive" class="text-gray-900 hover:text-ocean-blue transition-colors duration-300 font-medium flex items-center space-x-2 bg-gradient-to-r from-blue-500 to-indigo-500 text-white px-3 py-1 rounded-full pulse">
            <i class="fas fa-robot text-sm"></i>
            <span>IA Interactive</span>
          </a>
        </div>
        
        <!-- User Actions -->
        <div class="flex items-center space-x-4">
          {{#if user}}
            <!-- Favorites (only for tourists) -->
            {{#if (eq user.role 'TOURISTE')}}
              <a href="/touriste/favorites" class="text-gray-700 hover:text-rose-600 transition-colors duration-300 p-2 rounded-lg hover:bg-gray-50" title="Mes favoris">
                <i class="fas fa-heart text-lg"></i>
              </a>
            {{/if}}
            
            <!-- 🔥 PRO NOTIFICATION BELL -->
            <div class="relative">
              <!-- 🔔 BUTTON -->
              <button onclick="toggleNotif()" class="text-gray-700 hover:text-ocean-blue transition-colors duration-300 p-2 rounded-lg hover:bg-gray-50 relative" title="Notifications" style="display: flex !important; visibility: visible !important;">
