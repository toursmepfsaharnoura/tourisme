                <!-- 🔴 BADGE -->
                <span id="notifBadge" class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center font-bold" style="display: none !important;">0</span>
              </button>
              
              <!-- 📥 DROPDOWN -->
              <div id="notifDropdown" class="hidden absolute right-0 mt-2 w-80 bg-white rounded-xl shadow-xl z-50 border border-gray-100">
                
                <div class="p-4 border-b border-gray-200 font-bold text-gray-900 flex justify-between items-center">
                  <span>Notifications</span>
                  <a href="/guide/notifications/{{user.id}}" class="text-xs text-ocean-blue hover:text-ocean-dark font-medium">Voir tout</a>
                </div>
                
