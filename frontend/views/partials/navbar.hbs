                  <!-- JS will fill here -->
                  <div class="text-center py-8 text-gray-500">
                    <i class="fas fa-bell-slash text-3xl mb-2"></i>
                    <p class="text-sm">Aucune notification</p>
                  </div>
                </div>
                
              </div>
            </div>
            
            <!-- Messages -->
            <a href="/messages" class="text-gray-700 hover:text-ocean-blue transition-colors duration-300 p-2 rounded-lg hover:bg-gray-50">
