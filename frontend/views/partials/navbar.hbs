                  <img src="{{user.photo_profil}}" alt="{{user.nom_complet}}" class="w-8 h-8 rounded-full object-cover border-2 border-ocean-blue">
                {{else}}
                  <div class="w-8 h-8 rounded-full bg-gradient-to-br from-ocean-blue to-sage-green flex items-center justify-center">
                    <i class="fas fa-user text-white text-sm"></i>
                  </div>
                {{/if}}
                <span class="hidden md:block font-medium text-gray-900">{{user.nom_complet}}</span>
                <i class="fas fa-chevron-down text-xs text-gray-500"></i>
              </button>
              
              <!-- Dropdown Menu -->
              <div class="absolute right-0 mt-2 glass-morphism rounded-2xl border border-gray-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform group-hover:translate-y-0 translate-y-2">
