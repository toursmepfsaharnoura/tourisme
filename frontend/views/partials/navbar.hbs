                  <a href="/admin/dashboard" class="block px-4 py-3 text-gray-700 hover:bg-gray-50 transition-colors duration-300">
                    <i class="fas fa-tachometer-alt mr-3 text-desert-orange"></i>
                    Tableau de bord
                  </a>
                {{/if}}
                {{#if (eq user.role 'GUIDE')}}
                  <a href="/guide/dashboard" class="block px-4 py-3 text-gray-700 hover:bg-gray-50 transition-colors duration-300">
                    <i class="fas fa-tachometer-alt mr-3 text-ocean-blue"></i>
                    Mon Espace
                  </a>
                {{/if}}
                {{#if (eq user.role 'TOURISTE')}}
                  <a href="/touriste/dashboard" class="block px-4 py-3 text-gray-700 hover:bg-gray-50 transition-colors duration-300">
                    <i class="fas fa-tachometer-alt mr-3 text-sage-green"></i>
                    Mon Espace
                  </a>
                {{/if}}
                <!-- Notifications (pour tous les utilisateurs) -->
                <a href="/guide/notifications/{{user.id}}" class="block px-4 py-3 text-gray-700 hover:bg-gray-50 transition-colors duration-300">
                  <i class="fas fa-bell mr-3 text-ocean-blue"></i>
                  Notifications
                  <span id="notifBadgeMobile" class="ml-2 bg-red-500 text-white text-xs px-2 py-1 rounded-full">0</span>
                </a>
                <a href="/profile" class="block px-4 py-3 text-gray-700 hover:bg-gray-50 transition-colors duration-300">
                  <i class="fas fa-user mr-3 text-ocean-blue"></i>
                  Profil
                </a>
                <a href="/logout" class="block px-4 py-3 text-gray-700 hover:bg-gray-50 transition-colors duration-300">
                  <i class="fas fa-sign-out-alt mr-3 text-desert-orange"></i>
                  Déconnexion
                </a>
              </div>
            </div>
          {{else}}
